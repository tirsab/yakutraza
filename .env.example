# Copia este archivo como .env y ajusta los valores.

# Carpeta con los CSV DS01-DS09 y diccionario_variables.xlsx.
# Los datos NO se versionan (uso exclusivo de los equipos inscritos; ver README).
DATA_DIR=C:/yakutraza/data

# "Hoy" para la demo: fecha de corte de la muestra (Léame del diccionario).
FECHA_CORTE=2026-09-30

# Base de datos. Con Docker: PostgreSQL 16 del servicio `db`.
POSTGRES_USER=yakutraza
POSTGRES_PASSWORD=yakutraza_local
POSTGRES_DB=yakutraza
# Puerto publicado en el host (5433 para no chocar con un PostgreSQL local en 5432).
POSTGRES_PORT=5433
# URL para correr la CLI o pytest desde el host contra la base de Docker.
# (Dentro de Docker, docker-compose.yml fija su propia URL al servicio `db`.)
DATABASE_URL=postgresql+psycopg://yakutraza:yakutraza_local@localhost:5433/yakutraza
# Sin Docker (solo desarrollo y pruebas) puedes usar SQLite:
# DATABASE_URL=sqlite:///./yakutraza_local.db
